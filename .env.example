# Modelo das senhas e tokens. Copie para .env.development (dotnet run) e .env.production (Docker)
# e preencha. Esses arquivos nunca vão para o git. Use tokens diferentes em cada ambiente.
# O servidor lê sozinho o .env do ambiente atual (ASPNETCORE_ENVIRONMENT). Escreva os valores sem aspas.
# Uso com Docker:
#   docker run --env-file .env.production -p 8080:8080 -v flood-data:/app/App_Data flood-monitor
# Em hospedagens (Render, Railway, Azure...), cadastre as mesmas variáveis no painel.

# Login da área administrativa (/admin): relatórios de acesso e exclusão de ocorrências.
# Sem as três variáveis, a área administrativa fica desligada.
Admin__Username=
# Senha com no mínimo 12 caracteres.
Admin__Password=
# Token fixo que o site recebe depois do login (mínimo de 32 caracteres). Trocar o token encerra todas as sessões.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
Admin__Token=

# Medições de chuva dos pluviômetros do CEMADEN (seção Chuvas).
# Crie uma conta gratuita em https://ped.cemaden.gov.br e informe o e-mail e a senha dela.
# Sem elas, a seção Chuvas mostra só as estimativas do Open-Meteo.
Cemaden__Email=
Cemaden__Password=

# true quando o app fica atrás de um proxy que cuida do HTTPS (Render, Railway, nginx...).
# Assim o limite de envios usa o IP real de cada pessoa. Deixe false se o app recebe acesso direto.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=false

# Domínio público do site, para recusar requisições com outro Host. Ex.: monitor.exemplo.com.br
AllowedHosts=*
